FROM node:22.18.0-bookworm-slim AS node
FROM python:3.13-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libstdc++6 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1
WORKDIR /app
COPY requirements-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt
COPY package.json ./
COPY ecg/ ./ecg/
COPY lib/ ./lib/
COPY scripts/agentrouter_bridge.mjs ./scripts/agentrouter_bridge.mjs

EXPOSE 80
CMD ["python", "-m", "uvicorn", "ecg.api:app", "--host", "0.0.0.0", "--port", "80"]
