# Reuse the existing AgentRouter credentials. Never put real keys in this file.
AGENTROUTER_API_KEY=
AGENTROUTER_API_KEY_2=
# Optional overrides; existing models and endpoint remain the defaults.
AGENTROUTER_MODEL=gpt-5.6-sol
AGENTROUTER_FALLBACK_MODEL=gpt-6.1-sol
ECG_API_URL=http://127.0.0.1:8765
PORT=3000
ECG_LLM_ENABLED=1
# Strict explanation temperature 0.2 is the default.
# Compatibility is an explicit UI / request flag: allow_provider_default_temperature.
